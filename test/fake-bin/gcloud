#!/bin/sh
# Fake gcloud for tests: maps the few "gcloud compute" calls rx makes onto the docker test container.
#   instances start|stop|describe NAME   docker start/stop/inspect
#   disks resize NAME --size S           grow the container's loopback data disk to S
# RX_TEST_GCLOUD_STOCKOUT=1 (or =<file> with a captured error) makes "instances start" fail like a Spot stockout.
echo "gcloud $*" >>"${RX_TEST_GCLOUD_LOG:-/dev/null}"
c=${RX_TEST_CONTAINER:?}
case "$1 $2 $3" in
  "compute instances start")
    if [ -f "${RX_TEST_GCLOUD_STOCKOUT:-}" ]; then # a captured real error text
      cat "$RX_TEST_GCLOUD_STOCKOUT" >&2
      exit 1
    elif [ -n "${RX_TEST_GCLOUD_STOCKOUT:-}" ]; then
      echo "ERROR: (gcloud.compute.instances.start) Could not fetch resource:" >&2
      echo " - The zone 'projects/p/zones/z' does not have enough resources available to fulfill the request. Try a different zone, or try again later. (ZONE_RESOURCE_POOL_EXHAUSTED)" >&2
      exit 1
    fi
    echo "Starting instance(s) $4...done." >&2
    docker start "$c" >/dev/null ;;
  "compute instances stop") docker stop "$c" >/dev/null ;;
  "compute instances describe")
    case $(docker inspect -f '{{.State.Running}}' "$c") in true) echo RUNNING ;; *) echo TERMINATED ;; esac ;;
  "compute disks resize")
    size=$(echo "$*" | sed -n 's/.*--size[ =]\([0-9]*\)GB.*/\1/p')
    [ -n "$size" ] || { echo "fake gcloud: need --size NGB" >&2; exit 1; }
    docker exec "$c" sh -c "truncate -s ${size}G /var/lib/rx-data.img && losetup -c \$(losetup -j /var/lib/rx-data.img | cut -d: -f1)" ;;
  *) echo "fake gcloud: unsupported: $*" >&2; exit 1 ;;
esac
