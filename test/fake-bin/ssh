#!/bin/sh
# Fake ssh for tests: the real ssh. With RX_TEST_VANISH=<file>, rsync's transport also deletes that
# file when its name passes by in the file list: after the sender listed it, before the box asks for it.
PATH=$(echo ":$PATH:" | sed "s|:$(dirname "$0"):|:|g; s|^:||; s|:\$||")
case "${RX_TEST_VANISH:+x} $*" in
  x*" recv --server "*) ;;
  *) exec ssh "$@" ;;
esac
exec perl -e '$SIG{CHLD} = sub { wait; exit $? >> 8 }; # ssh ended first: stop reading from rsync
  $n = $ENV{RX_TEST_VANISH}; $n =~ s|.*/||; open S, "|-", "ssh", @ARGV or die;
  while (sysread STDIN, $b, 65536) { unlink $ENV{RX_TEST_VANISH} if index($b, $n) >= 0; syswrite S, $b }
  close S; exit $? >> 8' -- "$@"
